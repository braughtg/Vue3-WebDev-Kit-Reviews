{
  "name": "vue3-webdev-kit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "linkcheck": "git ls-files '*.md' | xargs -r markdown-link-check -c .markdown-link-check.json",
    "format": "prettier --write .",
    "spell": "cspell '**'"
  },
  "devDependencies": {
    "@eslint/css": "^1.3.0",
    "@eslint/js": "^9.27.0",
    "@eslint/markdown": "^8.0.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "cspell": "^8.17.3",
    "eslint": "^9.27.0",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "json-server": "^1.0.0-beta.15",
    "lint-staged": "^15.5.2",
    "markdown-link-check": "^3.14.2",
    "prettier": "^3.5.3"
  },
  "lint-staged": {
    "*.{js,vue,html,css}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.md": [
      "prettier --write",
      "eslint --fix",
      "markdown-link-check -c .markdown-link-check.json"
    ],
    "*": "cspell --no-must-find-files"
  }
}
